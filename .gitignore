# Generated and downloaded datasets are excluded from version control.
# Reproduce these files using the sripts documented in README.md

# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.py[cod]

# Jupyter temporary files
.ipynb_checkpoints/

# VS Code project-specific settings
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Generated trained models
results/models/*
!results/models/.gitkeep

# Raw biological sequence data
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Environment variables and private configuration
.env
.env.*
!.env.example

# Python testing and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated logs and temp files
*.log
*.tmp

# Generated figures
results/figures/*
!results/figures/.gitkeep

# Python build and packaging artifacts
build/
dsit/
*.egg-info/

# Coverage reports
.coverage
.coverage.*
htmlcov/

# Local Python configuration
.python-version

# Temporary and backup files
*.bak 
*.swp
*~